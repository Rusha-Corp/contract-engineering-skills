{
  "name": "contract-engineering-skills",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "remoteUser": "vscode",
  "runArgs": [
    "--platform=linux/amd64"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.factory,target=/home/vscode/.factory,type=bind,readonly"
  ],
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "postCreateCommand": "python -m pip install --disable-pip-version-check --no-input --require-hashes -r requirements-ci.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "Factory.factory-vscode-extension"
      ]
    }
  }
}
