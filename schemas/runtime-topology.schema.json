{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rusha-Corp/contract-engineering-skills/schemas/runtime-topology.schema.json",
  "title": "Project-owned runtime topology",
  "type": "object",
  "required": [
    "version",
    "components"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "paths",
          "environments",
          "consumers",
          "shared_resources",
          "identities",
          "couplings"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "$ref": "#/$defs/component_kind"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "environments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "shared_resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "identities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "couplings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "to",
                "effect",
                "compatibility"
              ],
              "properties": {
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "effect": {
                  "type": "string",
                  "minLength": 1
                },
                "compatibility": {
                  "$ref": "#/$defs/compatibility"
                },
                "rationale": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "component_kind": {
      "enum": [
        "service",
        "library",
        "deployment",
        "permission",
        "data",
        "external",
        "other"
      ]
    },
    "compatibility": {
      "enum": [
        "compatible",
        "incompatible",
        "unknown"
      ]
    }
  }
}
