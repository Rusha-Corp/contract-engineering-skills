{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rusha-Corp/contract-engineering-skills/schemas/work-packet.schema.json",
  "title": "Contract Engineering Work Packet",
  "type": "object",
  "required": [
    "packet_id",
    "task_id",
    "phase",
    "domain",
    "title",
    "objective",
    "scope",
    "owner",
    "reviewer",
    "cleanup_owner",
    "dependencies",
    "locks",
    "baseline_refs",
    "acceptance_criteria",
    "validation_plan",
    "state"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+-T[0-9]{3}-P[0-9]{3}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+-T[0-9]{3}$"
    },
    "phase": {
      "type": "string",
      "pattern": "^P[0-9]+_[A-Z0-9_]+$"
    },
    "domain": {
      "enum": ["coding", "browser", "design", "data", "documentation", "security"]
    },
    "packet_class": {
      "enum": [
        "single-domain",
        "cross-cutting",
        "parent-coordination",
        "child-implementation"
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "actor": {
      "type": "object",
      "required": ["agent_id", "harness", "model", "session_id"],
      "properties": {
        "agent_id": {"type": "string"},
        "harness": {"type": "string"},
        "model": {"type": "string"},
        "session_id": {"type": "string"}
      },
      "additionalProperties": true
    },
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "risk_tier": {"enum": ["low", "medium", "high", "critical"]},
    "approval_policy": {"enum": ["automatic", "reviewer", "user", "two_person"]},
    "external_effects": {
      "type": "array",
      "items": {
        "anyOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": [
              "effect_id",
              "target",
              "operation",
              "data_classification",
              "approval_ref",
              "rollback"
            ]
          }
        ]
      }
    },
    "evidence_policy": {
      "$ref": "evidence-policy.schema.json"
    },
    "research_gap_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^CENG-(GAP|SEC)-[0-9]{3}$"}
    },
    "scope": {
      "type": "object",
      "required": ["in", "out"],
      "properties": {
        "in": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "out": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "owner": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "cleanup_owner": {"type": "string", "minLength": 1},
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z0-9-]+-T[0-9]{3}-P[0-9]{3}$"}
    },
    "locks": {"type": "array", "items": {"type": "string"}},
    "claim_timestamp": {"type": "string"},
    "baseline_refs": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "design_decision_ref": {"type": ["string", "null"]},
    "data_gate_ref": {"type": ["string", "null"]},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "validation_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "expected"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+-VAL[0-9]{3}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "trust_boundary_ref": {"type": ["string", "null"]},
    "execution_budget_ref": {"type": ["string", "null"]},
    "checkpoint_ref": {"type": ["string", "null"]},
    "evaluation_ref": {"type": ["string", "null"]},
    "agent_run_ref": {"type": ["string", "null"]},
    "observability_refs": {"type": "array", "items": {"type": "string"}},
    "incident_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "handoff_ref": {"type": ["string", "null"]},
    "skill_gaps": {"type": "array"},
    "cleanup_scope": {"type": "object"},
    "stability": {"enum": ["stable", "beta", "experimental", "deprecated"]},
    "state": {
      "enum": [
        "Planned",
        "Claimed",
        "DesignReview",
        "DesignBlocked",
        "DataReview",
        "DataBlocked",
        "Ready",
        "Implementing",
        "Validation",
        "Rework",
        "Handoff",
        "Complete",
        "Interrupted",
        "Cancelled"
      ]
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": ["domain"],
            "properties": {"domain": {"const": "security"}}
          },
          {
            "required": ["risk_tier"],
            "properties": {
              "risk_tier": {"enum": ["high", "critical"]}
            }
          },
          {
            "required": ["external_effects"],
            "properties": {
              "external_effects": {"minItems": 1}
            }
          }
        ]
      },
      "then": {
        "required": [
          "actor",
          "capabilities",
          "risk_tier",
          "approval_policy",
          "external_effects"
        ]
      }
    },
    {
      "if": {
        "allOf": [
          {
            "anyOf": [
              {
                "required": ["domain"],
                "properties": {"domain": {"const": "security"}}
              },
              {
                "required": ["risk_tier"],
                "properties": {
                  "risk_tier": {"enum": ["high", "critical"]}
                }
              }
            ]
          },
          {
            "required": ["state"],
            "properties": {
              "state": {
                "enum": [
                  "Claimed",
                  "DesignReview",
                  "DesignBlocked",
                  "DataReview",
                  "DataBlocked",
                  "Ready",
                  "Implementing",
                  "Validation",
                  "Rework",
                  "Handoff"
                ]
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "trust_boundary_ref",
          "execution_budget_ref",
          "checkpoint_ref",
          "evaluation_ref",
          "agent_run_ref",
          "observability_refs",
          "incident_refs"
        ]
      }
    },
    {
      "if": {
        "required": ["packet_class", "external_effects"],
        "properties": {
          "external_effects": {"minItems": 1}
        }
      },
      "then": {
        "properties": {
          "external_effects": {
            "items": {"type": "object"}
          }
        }
      }
    }
  ]
}
